{
  "extends": "./tsconfig.base.json",
  "include": ["src"],
  "compilerOptions": {
    "types": ["node", "vitest", "vite/client", "@testing-library/jest-dom"],
    "jsx": "react-jsx",
      "skipLibCheck": true,
      "allowImportingTsExtensions": true,
      "noEmit": true,
      "strict": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noFallthroughCasesInSwitch": true,
      "noUncheckedSideEffectImports": true
  }
}